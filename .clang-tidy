---
# Static analysis for first-party code. Kept in step with the compiler warning
# set in cmake/CompilerWarnings.cmake.
Checks: >
  bugprone-*,
  cppcoreguidelines-*,
  modernize-*,
  performance-*,
  readability-*,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-magic-numbers,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay

WarningsAsErrors: ''
HeaderFilterRegex: 'src/(lib|app|render)/.*'
FormatStyle: file

CheckOptions:
  # Catch2's REQUIRE/CHECK/CAPTURE expand to a do-while with a try/catch and an
  # && chain each - about five points of cognitive complexity per assertion
  # before any nesting - so a test case with more than a handful of assertions
  # exceeds the default threshold of 25 whatever it does itself. Complexity is
  # judged on what the function's own code does; the check still applies in
  # full to production code.
  readability-function-cognitive-complexity.IgnoreMacros: true

  # Naming: the conventions the code follows, measured in October 2026 (D9 keeps
  # an established repository's own). Types are PascalCase, functions, methods,
  # locals, parameters and namespaces are lower_case, private and protected
  # members end in an underscore, constants are kPascal, macros are UPPER_CASE.
  # The Qt-facing code under src/app is camelCase (src/app/.clang-tidy).
  # EnumConstantCase is left unset on purpose: 26 enums use lower_case and 20
  # use PascalCase, in the same weeks. The *IgnoredRegexp entries name the
  # exceptions that mirror an outside API or are newer than the rule; renaming
  # them is a separate change (docs/migration.md).
  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.UnionCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.ConceptCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TemplateParameterCase: CamelCase
  readability-identifier-naming.FunctionCase: lower_case
  readability-identifier-naming.MethodCase: lower_case
  readability-identifier-naming.ParameterCase: lower_case
  readability-identifier-naming.LocalVariableCase: lower_case
  readability-identifier-naming.MemberCase: lower_case
  readability-identifier-naming.PrivateMemberSuffix: _
  readability-identifier-naming.ProtectedMemberSuffix: _
  readability-identifier-naming.ConstexprVariableCase: CamelCase
  readability-identifier-naming.ConstexprVariablePrefix: k
  readability-identifier-naming.GlobalConstantCase: CamelCase
  readability-identifier-naming.GlobalConstantPrefix: k
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
  readability-identifier-naming.ClassIgnoredRegexp: '^mapping$'
  readability-identifier-naming.StructIgnoredRegexp: '^[a-z][a-z0-9_]*$'
  readability-identifier-naming.EnumIgnoredRegexp: '^[a-z][a-z0-9_]*$'
  readability-identifier-naming.TypeAliasIgnoredRegexp: '^[a-z][a-z0-9_]*$'
  readability-identifier-naming.ConstexprVariableIgnoredRegexp: '^([a-z][a-z0-9_]*|[A-Z])$'
  readability-identifier-naming.MacroDefinitionIgnoredRegexp: '^(gl[A-Z][A-Za-z0-9]*|CUBE_PROFILING_PASTE_)$'
  readability-identifier-naming.LocalVariableIgnoredRegexp: '^(assertion_|writeCrashDump|ES_CONTINUOUS|keepAwake|shortScreen|k[A-Z][A-Za-z0-9]*)$'
  readability-identifier-naming.MemberIgnoredRegexp: '^(keepAwake|activeSignals|heldSignals)$'
  readability-identifier-naming.GlobalConstantIgnoredRegexp: '^(installer|g_process_start)$'
